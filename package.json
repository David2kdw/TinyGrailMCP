{
  "name": "tinygrail-mcp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "mcp": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "doctor": "node dist/cli.js doctor",
    "verify:public": "node dist/cli.js verify-public",
    "verify:account": "node dist/cli.js verify-account",
    "docs:tools": "node dist/cli.js export-tools",
    "format": "prettier --write src test package.json tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "decimal.js": "10.6.0",
    "lossless-json": "4.3.3",
    "playwright": "1.64.1",
    "tough-cookie": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
